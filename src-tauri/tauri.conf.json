{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "Datasoc",
  "version": "0.1.0",
  "identifier": "com.basedcatx.datasoc",
  "build": {
    "frontendDist": "../.output/public/",
    "devUrl": "http://localhost:3000",
    "beforeDevCommand": "bun dev",
    "beforeBuildCommand": "bun run build"
  },
  "app": {
    "windows": [
      {
        "title": "Datasoc",
        "width": 800,
        "height": 600,
        "resizable": true,
        "fullscreen": false,
        "devtools": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "windows": {
        "webviewInstallMode": {
        "type": "offlineInstaller"
      }
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": ["./res/*"],
    "android": {
      "debugApplicationIdSuffix": ".debug"
    }
  }
}
