{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "enables the default permissions",

  "windows": [
    "main"
  ],

  "permissions": [
    "core:default",
    "store:default",
    "fs:allow-read-dir",
    "fs:allow-applocaldata-read-recursive",
    "fs:allow-app-write-recursive",
    "fs:allow-applocaldata-write-recursive"
  ]
 
}
